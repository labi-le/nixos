#!/system/bin/sh

DIR=/data/local/stplay
QS=/system/vendor/quasar
BB=/system/bin/busybox-smp
BASE=http://192.168.1.2/music
PLAYLIST=$BASE/Playlists/Favorite%20Tracks.m3u8
URLS=$DIR/urls
TITLES=$DIR/titles
MODE=$DIR/mode
IDX=$DIR/idx
GEN=$DIR/gen
PID=$DIR/pid
SUPER=$DIR/super.pid
COUNT=$DIR/count
LOG=$DIR/maind.log

mkdir -p "$DIR"
umask 0
chmod 777 "$DIR"
for f in "$LOG" "$DIR/super.log" "$DIR/httpd.log"; do
  : >> "$f"
  chmod 666 "$f"
done

readf() { cat "$1" 2>/dev/null; }
writef() { printf '%s\n' "$2" > "$1"; chmod 666 "$1"; }

refresh() {
  $BB wget -q -O "$DIR/pl.tmp" "$PLAYLIST" || return 1
  $BB awk -v base="$BASE/" '
    BEGIN { for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i }
    function enc(s,   out, i, c, n) {
      out = ""; n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (c ~ /^[A-Za-z0-9._~\/-]$/) out = out c
        else out = out sprintf("%%%02X", ord[c])
      }
      return out
    }
    /^#EXTINF/ { t = $0; sub(/^[^,]*,/, "", t); next }
    /^#/ { next }
    /^[[:space:]]*$/ { next }
    { u = $0; sub(/^\.\.\//, "", u); print base enc(u) "\t" t }
  ' "$DIR/pl.tmp" > "$DIR/items" || return 1
  $BB cut -f1 "$DIR/items" > "$DIR/urls.new"
  $BB cut -f2- "$DIR/items" > "$DIR/titles.new"
  chmod 666 "$DIR/urls.new" "$DIR/titles.new"
  writef "$COUNT" "$($BB wc -l < "$DIR/urls.new" | $BB tr -d ' ')"
  mv "$DIR/urls.new" "$URLS"
  mv "$DIR/titles.new" "$TITLES"
  rm -f "$DIR/pl.tmp" "$DIR/items"
}

super() {
  writef "$SUPER" "$$"
  while [ "$(readf "$MODE")" = play ]; do
    if [ "$($BB wc -c < "$LOG")" -gt 1048576 ] 2>/dev/null; then
      : > "$LOG"
    fi
    i=$(readf "$IDX")
    [ -n "$i" ] || i=1
    g=$(readf "$GEN")
    url=$($BB sed -n "${i}p" "$URLS")
    if [ -z "$url" ]; then
      writef "$MODE" stop
      break
    fi
    (
      cd "$QS" || exit 1
      LD_LIBRARY_PATH="$QS:libs" exec "$QS/maind" --gst-launch \
        "souphttpsrc location=$url ! decodebin ! audioconvert ! audioresample ! openslessink"
    ) >>"$LOG" 2>&1 &
    p=$!
    writef "$PID" "$p"
    wait "$p"
    rm -f "$PID"
    [ "$(readf "$MODE")" = play ] || break
    [ "$(readf "$GEN")" = "$g" ] || continue
    c=$(readf "$COUNT")
    [ -n "$c" ] || c=0
    n=$((i + 1))
    [ "$n" -le "$c" ] || n=1
    writef "$IDX" "$n"
  done
  writef "$MODE" stop
  rm -f "$SUPER"
}

start_super() {
  sp=$(readf "$SUPER")
  if [ -n "$sp" ] && kill -0 "$sp" 2>/dev/null; then
    return 0
  fi
  $BB setsid /data/local/bin/stplay super >>"$DIR/super.log" 2>&1 &
}

bump() {
  g=$(readf "$GEN")
  [ -n "$g" ] || g=0
  writef "$GEN" "$((g + 1))"
}

kill_track() {
  p=$(readf "$PID")
  [ -n "$p" ] && kill "$p" 2>/dev/null
}

ensure_queue() {
  c=$(readf "$COUNT")
  if [ -n "$c" ] && [ "$c" -gt 0 ] && [ -s "$URLS" ]; then
    return 0
  fi
  refresh
}

start_index() {
  ensure_queue || return 1
  c=$(readf "$COUNT")
  n=$1
  [ "$n" -ge 1 ] 2>/dev/null || n=1
  [ "$n" -le "$c" ] 2>/dev/null || n="$c"
  writef "$IDX" "$n"
  writef "$MODE" play
  bump
  kill_track
  start_super
}

shift_index() {
  ensure_queue || return 1
  c=$(readf "$COUNT")
  i=$(readf "$IDX")
  [ -n "$i" ] || i=1
  n=$((i + $1))
  [ "$n" -ge 1 ] || n="$c"
  [ "$n" -le "$c" ] || n=1
  writef "$IDX" "$n"
  writef "$MODE" play
  bump
  kill_track
  start_super
}

status() {
  i=$(readf "$IDX")
  c=$(readf "$COUNT")
  m=$(readf "$MODE")
  [ -n "$i" ] || i=0
  [ -n "$c" ] || c=0
  [ -n "$m" ] || m=stop
  t=""
  if [ "$i" -ge 1 ] 2>/dev/null; then
    t=$(readf "$TITLES" | $BB sed -n "${i}p")
  fi
  printf '%s %s %s %s\n' "$m" "$i" "$c" "$t"
}

httpd_up() {
  $BB netstat -ltn 2>/dev/null | $BB grep -q ':8088' && return 0
  $BB setsid $BB httpd -p 8088 -h "$DIR/www" >>"$DIR/httpd.log" 2>&1 &
}

ctl() {
  q=$1
  cmd=${q#cmd=}
  cmd=${cmd%%&*}
  idx=${q#*idx=}
  [ "$idx" = "$q" ] && idx=""
  idx=${idx%%&*}
  case "$cmd" in
    status) status ;;
    list) $BB awk '{ print NR "\t" $0 }' "$TITLES" ;;
    play) start_index "${idx:-1}" ;;
    next) shift_index 1 ;;
    prev) shift_index -1 ;;
    pause)
      p=$(readf "$PID")
      if [ -n "$p" ]; then
        writef "$MODE" pause
        kill -STOP "$p" 2>/dev/null
      fi
      ;;
    resume)
      p=$(readf "$PID")
      if [ -n "$p" ]; then
        writef "$MODE" play
        kill -CONT "$p" 2>/dev/null
      fi
      ;;
    toggle)
      if [ "$(readf "$MODE")" = pause ]; then
        ctl cmd=resume
      else
        ctl cmd=pause
      fi
      ;;
    stop)
      writef "$MODE" stop
      kill_track
      sp=$(readf "$SUPER")
      [ -n "$sp" ] && kill "$sp" 2>/dev/null
      ;;
    refresh) refresh ;;
  esac
}

case "$1" in
  super) super ;;
  refresh) refresh ;;
  play) start_index "${2:-1}" ;;
  next) shift_index 1 ;;
  prev) shift_index -1 ;;
  stop) ctl cmd=stop ;;
  pause) ctl cmd=pause ;;
  resume) ctl cmd=resume ;;
  status) status ;;
  ctl) ctl "$2" ;;
  httpd) httpd_up ;;
  daemon)
    httpd_up
    start_super
    ;;
esac
