{
  "mcpServers": {
    "nixos": {
      "type": "stdio",
      "command": "nix",
      "args": ["run", "github:utensils/mcp-nixos", "--"],
      "timeout_secs": 300
    },
    "nix-control": {
      "type": "stdio",
      "command": "python3",
      "args": ["-B", ".omp/nix-control-mcp"],
      "timeout_secs": 3600
    }
  }
}
