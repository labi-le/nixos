{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "nixos": {
      "command": "nix",
      "args": ["run", "github:utensils/mcp-nixos", "--"]
    },
    "nix-control": {
      "type": "stdio",
      "command": "python3",
      "args": ["-B", ".omp/nix-control-mcp"],
      "timeout": 0
    }
  }
}
