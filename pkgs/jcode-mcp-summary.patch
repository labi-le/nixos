 #[test]
+fn test_tool_summary_covers_mcp_calls() {
+    let call = ToolCall {
+        id: "call_mcp_call".to_string(),
+        name: "mcp_call".to_string(),
+        input: serde_json::json!({
+            "server": "example",
+            "tool": "example_tool",
+            "arguments": {},
+            "intent": "query"
+        }),
+        intent: None,
+        thought_signature: None,
+    };
+    let summary = tools_ui::get_tool_summary_with_budget(&call, 50, Some(60));
+    assert!(summary.contains("example_tool"), "summary={summary:?}");
+    assert!(summary.contains("example"), "summary={summary:?}");
+
+    let search = ToolCall {
+        id: "call_mcp_search".to_string(),
+        name: "mcp_search".to_string(),
+        input: serde_json::json!({ "query": "browser automation" }),
+        intent: None,
+        thought_signature: None,
+    };
+    let summary = tools_ui::get_tool_summary_with_budget(&search, 50, Some(60));
+    assert!(summary.contains("browser automation"), "summary={summary:?}");
+}
