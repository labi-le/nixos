+static void
+gdk_wayland_clipboard_selection_sync_done (void               *data,
+                                           struct wl_callback *callback,
+                                           uint32_t            callback_data)
+{
+  GdkWaylandClipboard *cb = GDK_WAYLAND_CLIPBOARD (data);
+  gboolean source_cancelled = cb->source_cancelled;
+
+  gdk_wayland_clipboard_discard_selection_sync (cb);
+
+  if (cb->source)
+    {
+      GDK_DISPLAY_DEBUG (gdk_clipboard_get_display (GDK_CLIPBOARD (cb)), CLIPBOARD,
+                         "%p: selection confirmed", cb);
+      gdk_wayland_clipboard_discard_offer (cb);
+    }
+  else if (source_cancelled)
+    {
+      GDK_DISPLAY_DEBUG (gdk_clipboard_get_display (GDK_CLIPBOARD (cb)), CLIPBOARD,
+                         "%p: selection not taken, using the last remote offer", cb);
+      if (cb->offer)
+        gdk_clipboard_claim_remote (GDK_CLIPBOARD (cb), cb->offer_formats);
+      else
+        gdk_wayland_clipboard_claim_remote (cb, NULL, gdk_content_formats_new (NULL, 0));
+    }
+}
+
+static const struct wl_callback_listener selection_sync_listener = {
+  gdk_wayland_clipboard_selection_sync_done,
+};
