      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (jail) (rate(f2b_jail_banned_total[$__rate_interval])) * 60",
          "legendFormat": "{{jail}}",
          "refId": "A"
