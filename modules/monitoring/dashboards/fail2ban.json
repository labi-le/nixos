    {
      "type": "timeseries",
      "title": "Bans per minute by jail",
      "description": "Rate of f2b_jail_banned_total, a counter that resets when fail2ban restarts.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
