      "type": "logs",
      "title": "Ban and unban events (Loki)",
      "description": "Exporter metrics have no per-IP label. This panel shows the raw fail2ban action lines, including addresses, from the journal stream Alloy ships with job=fail2ban.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 22 },
      "id": 9,
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"fail2ban\"} |~ \"Ban |Unban \"",
