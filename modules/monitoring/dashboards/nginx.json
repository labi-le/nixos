          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {},
            "renameByName": { "Value": "errors", "ip": "ip" }
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "desc": true, "field": "errors" }] }
        }
      ]
    },
