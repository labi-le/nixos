    {
      "type": "table",
      "title": "Top hosts, last hour",
      "description": "Request count per vhost parsed from the access log. The closing quote is optional because Alloy's query redaction can consume it.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 9,
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "topk(10, sum by (host) (count_over_time({job=\"nginx\", logtype=\"access\"} | regexp `(?P<host>https?://[^/ ]+)/[^\"]*\"? [0-9]+$` [1h])))",
          "queryType": "instant",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {},
            "renameByName": { "Value": "requests", "host": "host" }
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "desc": true, "field": "requests" }] }
        }
      ]
    },
    {
      "type": "table",
      "title": "Top 4xx/5xx clients, last hour",
      "description": "Client addresses producing 4xx and 5xx responses. Scanners and broken clients accumulate here first.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 10,
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "topk(10, sum by (ip) (count_over_time({job=\"nginx\", logtype=\"access\"} | regexp `^(?P<ip>\\S+) ` | regexp `HTTP/[0-9.]+. (?P<status>[0-9]{3}) ` | status=~\"4..|5..\" [1h])))",
          "queryType": "instant",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
