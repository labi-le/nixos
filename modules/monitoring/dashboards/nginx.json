    {
      "type": "timeseries",
      "title": "Responses by status class",
      "description": "Access log status classes. stub_status has no status labels, so these come from Loki and include traffic to every vhost.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"nginx\", logtype=\"access\"} | regexp `HTTP/[0-9.]+. (?P<status>[0-9]{3}) ` | status=~\"2..\" [$__interval]))",
          "legendFormat": "2xx",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "loki" },
