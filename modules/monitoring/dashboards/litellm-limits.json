    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "One row per check. Status is up when the check is healthy and down when it is not; price sync is inverted from its anomaly gauge. Age is the time since the last run or last success, and is empty for the provider sources.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "check"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "down",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "up",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 7
      },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "check"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "label_replace(label_replace(litellm_limits_exporter_success, \"check\", \"exporter\", \"__name__\", \".*\"), \"kind\", \"status\", \"__name__\", \".*\") or label_replace(label_replace(time() - litellm_limits_exporter_last_run_timestamp_seconds, \"check\", \"exporter\", \"__name__\", \".*\"), \"kind\", \"age\", \"__name__\", \".*\") or label_replace(label_replace(1 - litellm_price_sync_anomaly, \"check\", \"price sync\", \"__name__\", \".*\"), \"kind\", \"status\", \"__name__\", \".*\") or label_replace(label_replace(time() - litellm_price_sync_last_success_timestamp_seconds, \"check\", \"price sync\", \"__name__\", \".*\"), \"kind\", \"age\", \"__name__\", \".*\") or label_replace(label_replace(litellm_limits_source_up, \"check\", \"source $1\", \"source\", \"(.*)\"), \"kind\", \"status\", \"__name__\", \".*\")\n",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Pipeline health",
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^Value.*$",
            "renamePattern": "Value"
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "kind",
            "emptyValue": "null",
            "rowField": "check",
            "valueField": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "check\\kind": 0,
              "check": 0,
              "status": 1,
              "age": 2
            },
            "renameByName": {
              "check\\kind": "check"
            }
          }
        }
      ],
      "type": "table"
    },
