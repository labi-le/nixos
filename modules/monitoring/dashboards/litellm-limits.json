{
  "annotations": {
    "list": []
  },
  "description": "Provider-side API limits: the OpenCode Go account pool (rolling, weekly and monthly windows per account) and the ChatGPT/Codex subscription windows. Both come from the providers' own usage APIs, published by litellm-limits-exporter; client-key budgets are not part of this dashboard.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "OpenCode Go pool accounts with no window that takes them out of rotation: neither reported rate-limited by the provider nor at 95 percent of a window, the poller's own bench threshold. Four means the whole subscription is available.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "links": [],
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(count by (account) (litellm_opencode_go_window_status) unless count by (account) (litellm_opencode_go_window_status == 1 or litellm_opencode_go_used_percent >= 95)) or vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Accounts in rotation",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Account windows that take the account out of rotation: the provider reports them as rate-limited, or 95 percent of the window is spent, which is where the poller benches the account's deployments. Rolling windows reset in hours, weekly in up to a week, so this count is what to watch when the pool starts failing over.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "links": [],
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(litellm_opencode_go_window_status == 1 or litellm_opencode_go_used_percent >= 95) or vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Windows benched",
      "type": "stat"
    },
