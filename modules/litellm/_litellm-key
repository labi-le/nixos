#compdef litellm-key

_litellm-key() {
  local -a subcommands aliases
  subcommands=(
    'keys:list keys with expiry, spend and models'
    'logs:show recent request log rows'
    'totals:aggregate usage per alias'
    'create:create a key'
    'extend:move a key expiry by a duration (negative shortens it)'
    'revoke:delete a key'
    'help:show the usage text'
  )

  if (( CURRENT <= 2 )); then
    _describe -t commands 'command' subcommands
    return
  fi

  case $words[2] in
    extend | revoke)
      aliases=(${(f)"$(litellm-key keys 2>/dev/null | awk 'NR > 2 && NF { print $1 }')"})
      (( ${#aliases} )) && _describe -t aliases 'alias' aliases
      ;;
    *)
      _message 'argument'
      ;;
  esac
}

_litellm-key "$@"
