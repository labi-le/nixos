+    @property
+    def model_roles(self) -> dict[str, tuple[str, ...]]:
+        """Parse `task=model[|model];task=model` into per-task model pools."""
+        roles: dict[str, tuple[str, ...]] = {}
+        for entry in self.model_roles_raw.split(";"):
+            task, _, models = entry.partition("=")
+            pool = tuple(piece.strip() for piece in models.split("|") if piece.strip())
+            if task.strip() and pool:
+                roles[task.strip()] = pool
+        return roles
+
+    def model_pool_for(self, task_kind: str) -> tuple[str, ...]:
+        """Model pool for a task kind: its role, then release, then the general pool."""
+        role = self.model_roles.get(task_kind)
+        if role:
+            return role
+        if task_kind == "handle_release_ci" and self.release_model and self.release_model.strip():
+            return self.release_model_pool
+        return self.model_pool
+
+    def pick_model_for(self, task_kind: str) -> str:
+        """Random selection from the pool that owns this task kind."""
+        return random.choice(self.model_pool_for(task_kind))
+
